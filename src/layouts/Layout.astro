---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
}

const {
  title = "Ranger Steel Solutions — Wire Manufacturing & Technical Solutions",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <Font cssVariable="--font-plus-jakarta-sans" preload={[{ weight: 400 }]} />
  </head>
  <body class="text-steel-600 antialiased">
    <slot />
  </body>
</html>
